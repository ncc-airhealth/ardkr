# S3 호환 오브젝트 스토리지 접근 (현재 Cloudflare R2). 실제 값은 .env(git-ignored)에 채운다.
# 버킷명·엔드포인트는 비밀이 아니므로 실제 값을 커밋한다. 키는 절대 여기 채우지 않는다.
# private/open은 물리 bucket이 아니라 pipeline에서 사용하는 logical store 이름이다.
ARDKR_PRIVATE_BUCKET_NAME=geovars
ARDKR_PRIVATE_ENDPOINT_URL=https://0338bb0b6b16f3ee66ce6c88e715f9a5.r2.cloudflarestorage.com
ARDKR_PRIVATE_ACCESS_KEY_ID=
ARDKR_PRIVATE_SECRET_ACCESS_KEY=

ARDKR_OPEN_BUCKET_NAME=ardkr-open
ARDKR_OPEN_ENDPOINT_URL=https://0338bb0b6b16f3ee66ce6c88e715f9a5.r2.cloudflarestorage.com
ARDKR_OPEN_ACCESS_KEY_ID=
ARDKR_OPEN_SECRET_ACCESS_KEY=
# open store의 공개 HTTPS base URL (예: R2 public bucket의 pub-*.r2.dev 또는 custom domain).
# STAC asset href가 이 base에 키를 붙여 발행된다. 버킷에 익명 GET을 허용해야 브라우저에서 보인다.
ARDKR_OPEN_PUBLIC_URL=https://pub-971e04c6b4ee4304b9463f2e375033b3.r2.dev

# Local cache path for direct tests; pipeline/run.py overrides this in Docker.
ARDKR_S3_CACHE_DIR=.cache/s3
